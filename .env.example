# ══════════════════════════════════════════════════════════
#  CPAM — Variables d'environnement pour Coolify
#  Copier ces valeurs dans : Coolify → App → Environment
# ══════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire-ici
DEBUG=False

# ── Base de données PostgreSQL ────────────────────────────
# Ces valeurs sont disponibles dans Coolify
# quand tu crées une ressource PostgreSQL
DB_NAME=cpam
DB_USER=cpam_user
DB_PASSWORD=mot-de-passe-fort
DB_HOST=votre-host-postgres.coolify.internal
DB_PORT=5432

# ═══════════════════════════════════════════════════════════
# ✅ ALLOWED_HOSTS   → cpam.sacko-tech.com (fixé dans le code)
# ✅ CORS            → https://cpam.sacko-tech.com (fixé dans le code)
# ✅ VITE_API_BASE_URL → /api (même conteneur, pas nécessaire)
# ═══════════════════════════════════════════════════════════
