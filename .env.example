# ══════════════════════════════════════════════
#  CPAM — Variables d'environnement pour Coolify
#  Copier ces valeurs dans Coolify → Environment
# ══════════════════════════════════════════════

# ── Django ──────────────────────────────────────
SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
DEBUG=False

# ── Base de données PostgreSQL (Coolify) ─────────
# Copier l'URL depuis la ressource PostgreSQL Coolify
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/cpam

# ─────────────────────────────────────────────────
# ✅ ALLOWED_HOSTS   → déjà fixé dans le code (cpam.sacko-tech.com)
# ✅ CORS            → déjà fixé dans le code (https://cpam.sacko-tech.com)
# ✅ VITE_API_BASE_URL → /api (même domaine, pas nécessaire)
# ─────────────────────────────────────────────────
