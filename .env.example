# ──────────────────────────────────────────────
# CPAM – Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ──────────────────────────────────────────────

# ── Django ──────────────────────────────────────
SECRET_KEY=changez-moi-par-une-vraie-clé-secrète
DEBUG=False
# Ton domaine Coolify (sans https://)
ALLOWED_HOSTS=votre-domaine.com

# ── Base de données PostgreSQL ───────────────────
POSTGRES_DB=cpam
POSTGRES_USER=cpam_user
POSTGRES_PASSWORD=mot-de-passe-fort-ici
DATABASE_URL=postgres://cpam_user:mot-de-passe-fort-ici@db:5432/cpam

# ── CORS (même domaine que le frontend) ──────────
CORS_ALLOWED_ORIGINS=https://votre-domaine.com

# Remarque : VITE_API_BASE_URL n'est plus nécessaire
# car le frontend appelle /api (même domaine, même conteneur)
